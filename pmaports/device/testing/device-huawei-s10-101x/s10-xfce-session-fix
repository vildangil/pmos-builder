#!/bin/sh
# Huawei MediaPad 10 FHD XFCE repair/performance helper.
# Runs inside the real XFCE user session; never replaces packaged menus.

logfile="$HOME/.cache/s10-xfce-session-fix.log"
mkdir -p "$HOME/.cache" "$HOME/.local/share/applications" "$HOME/Desktop" 2>/dev/null || true

log() {
    printf '%s\n' "$*" >>"$logfile" 2>/dev/null || true
}

is_running() {
    pgrep -x "$1" >/dev/null 2>&1
}

start_if_missing() {
    proc="$1"
    shift
    if is_running "$proc"; then
        log "$proc already running"
        return 0
    fi
    command -v "$proc" >/dev/null 2>&1 || {
        log "$proc binary missing"
        return 0
    }
    "$@" >>"$logfile" 2>&1 &
    pid=$!
    sleep 1
    if kill -0 "$pid" 2>/dev/null || is_running "$proc"; then
        log "$proc fallback started"
    else
        log "$proc fallback failed"
    fi
}

log "start DISPLAY=${DISPLAY:-unset} XDG_CURRENT_DESKTOP=${XDG_CURRENT_DESKTOP:-unset}"

# A real XFCE session normally starts all of these. On the bring-up image
# LightDM occasionally reaches the desktop with only part of the session.
# In particular, a missing xfwm4 produces undecorated terminal windows.
start_if_missing xfsettingsd xfsettingsd --replace
start_if_missing xfwm4 xfwm4 --replace
start_if_missing xfdesktop xfdesktop
start_if_missing xfce4-panel xfce4-panel
start_if_missing xfce4-power-manager xfce4-power-manager

# Compositing at 1920x1200 is too expensive until GC4000/etnaviv works.
if command -v xfconf-query >/dev/null 2>&1; then
    xfconf-query -c xfwm4 -p /general/use_compositing -s false >/dev/null 2>&1 ||
        xfconf-query -c xfwm4 -p /general/use_compositing -n -t bool -s false >/dev/null 2>&1 || true
fi

apps="$HOME/.local/share/applications"
desktop="$HOME/Desktop"

make_entry() {
    cmd="$1"
    file="$2"
    name="$3"
    icon="$4"
    categories="$5"
    command -v "$cmd" >/dev/null 2>&1 || return 0
    cat >"$apps/$file" <<EOF
[Desktop Entry]
Type=Application
Name=$name
Exec=$cmd
Icon=$icon
Terminal=false
Categories=$categories
OnlyShowIn=XFCE;
EOF
}

# These are escape hatches only. They do not replace the distro Garcon menu.
make_entry xfce4-appfinder s10-applications.desktop Applications org.xfce.appfinder 'Utility;System;'
make_entry xfce4-settings-manager s10-settings.desktop Settings preferences-system 'Settings;System;'
make_entry xfce4-terminal s10-terminal.desktop Terminal utilities-terminal 'System;TerminalEmulator;'
make_entry thunar s10-files.desktop Files system-file-manager 'System;FileManager;'

for pair in \
    's10-applications.desktop:Applications.desktop' \
    's10-settings.desktop:Settings.desktop' \
    's10-terminal.desktop:Terminal.desktop' \
    's10-files.desktop:Files.desktop'; do
    src=${pair%%:*}
    dst=${pair#*:}
    if [ -r "$apps/$src" ]; then
        cp -f "$apps/$src" "$desktop/$dst" 2>/dev/null || true
        chmod 0755 "$desktop/$dst" 2>/dev/null || true
    fi
done

command -v xfdesktop >/dev/null 2>&1 && xfdesktop --reload >/dev/null 2>&1 || true

log "wm=$(pgrep -x xfwm4 2>/dev/null | tr '\n' ',') panel=$(pgrep -x xfce4-panel 2>/dev/null | tr '\n' ',') desktop=$(pgrep -x xfdesktop 2>/dev/null | tr '\n' ',') settings=$(pgrep -x xfsettingsd 2>/dev/null | tr '\n' ',')"
exit 0

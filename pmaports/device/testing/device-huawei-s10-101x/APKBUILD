# WIP device package for Huawei MediaPad 10 FHD S10-101x
pkgname=device-huawei-s10-101x
pkgdesc="Huawei MediaPad 10 FHD S10-101x"
pkgver=0.1
pkgrel=7
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-huawei-s10-101x
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	pmos-trace-sysinit.initd
	pmos-trace-boot.initd
	pmos-trace-default.initd
	s10-edc-xorg.conf
	s10-lightdm-no-autologin.conf
	s10-rootfs-cleanup.initd
	s10-xfce-applications.menu
	s10-xfce-settings-manager.menu
	s10-xfce-session-fix
	s10-xfce-session-fix.desktop
	s10-xdg.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	for phase in sysinit boot default; do
		install -Dm755 "$srcdir/pmos-trace-$phase.initd" \
			"$pkgdir/etc/init.d/pmos-trace-$phase"
		install -d "$pkgdir/etc/runlevels/$phase"
		ln -s "/etc/init.d/pmos-trace-$phase" \
			"$pkgdir/etc/runlevels/$phase/pmos-trace-$phase"
	done

	# EDC KMS is functional now. Keep Xorg on modesetting/card0 while avoiding
	# the old ShadowFB double copy; the EDC driver now has real vblank IRQs.
	install -Dm644 "$srcdir/s10-edc-xorg.conf" \
		"$pkgdir/etc/X11/xorg.conf.d/20-s10-edc.conf"

	# Require the normal LightDM greeter/password flow. Put this after all UI
	# package snippets so an old or distro autologin stanza cannot win by order.
	install -Dm644 "$srcdir/s10-lightdm-no-autologin.conf" \
		"$pkgdir/etc/lightdm/lightdm.conf.d/zz-s10-no-autologin.conf"

	# Remove every file written by the old initramfs XFCE bring-up hook on the
	# real root filesystem, after switch_root and before LightDM starts.
	install -Dm755 "$srcdir/s10-rootfs-cleanup.initd" \
		"$pkgdir/etc/init.d/s10-rootfs-cleanup"
	install -d "$pkgdir/etc/runlevels/boot"
	ln -s /etc/init.d/s10-rootfs-cleanup \
		"$pkgdir/etc/runlevels/boot/s10-rootfs-cleanup"

	# Keep pristine upstream Xfce 4.20 menu definitions outside the paths owned
	# by garcon/xfce4-settings. The cleanup service restores them at boot because
	# old test initramfs images overwrote /etc/xdg/menus in-place.
	install -Dm644 "$srcdir/s10-xfce-applications.menu" \
		"$pkgdir/usr/share/s10-xfce-defaults/xfce-applications.menu"
	install -Dm644 "$srcdir/s10-xfce-settings-manager.menu" \
		"$pkgdir/usr/share/s10-xfce-defaults/xfce-settings-manager.menu"

	# XFCE board defaults. Do not replace Alpine/XFCE's own Garcon menu XML here.
	# The session helper starts only missing standard XFCE components and creates
	# a few recovery launchers in the user's XDG application directory.
	install -Dm755 "$srcdir/s10-xfce-session-fix" \
		"$pkgdir/usr/libexec/s10-xfce-session-fix"
	install -Dm644 "$srcdir/s10-xfce-session-fix.desktop" \
		"$pkgdir/etc/xdg/autostart/s10-xfce-session-fix.desktop"
	install -Dm644 "$srcdir/s10-xdg.sh" \
		"$pkgdir/etc/profile.d/s10-xdg.sh"
}


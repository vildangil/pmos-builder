# WIP device package for Huawei MediaPad 10 FHD S10-101x
pkgname=device-huawei-s10-101x
pkgdesc="Huawei MediaPad 10 FHD S10-101x"
pkgver=0.1
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-huawei-s10-101x
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	pmos-trace-sysinit.initd
	pmos-trace-boot.initd
	pmos-trace-default.initd
	s10-edc-xorg.conf
	s10-xfce-session-fix
	s10-xfce-session-fix.desktop
	s10-xdg.sh
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	for phase in sysinit boot default; do
		install -Dm755 "$srcdir/pmos-trace-$phase.initd" \
			"$pkgdir/etc/init.d/pmos-trace-$phase"
		install -d "$pkgdir/etc/runlevels/$phase"
		ln -s "/etc/init.d/pmos-trace-$phase" \
			"$pkgdir/etc/runlevels/$phase/pmos-trace-$phase"
	done

	# EDC KMS is functional now. Keep Xorg on modesetting/card0 while avoiding
	# the old ShadowFB double copy; the EDC driver now has real vblank IRQs.
	install -Dm644 "$srcdir/s10-edc-xorg.conf" \
		"$pkgdir/etc/X11/xorg.conf.d/20-s10-edc.conf"

	# XFCE board defaults. Do not replace Alpine/XFCE's own Garcon menu XML.
	# The session helper creates only missing/recovery entries in the user's
	# XDG application directory and leaves packaged menu definitions intact.
	install -Dm755 "$srcdir/s10-xfce-session-fix" \
		"$pkgdir/usr/libexec/s10-xfce-session-fix"
	install -Dm644 "$srcdir/s10-xfce-session-fix.desktop" \
		"$pkgdir/etc/xdg/autostart/s10-xfce-session-fix.desktop"
	install -Dm644 "$srcdir/s10-xdg.sh" \
		"$pkgdir/etc/profile.d/s10-xdg.sh"
}


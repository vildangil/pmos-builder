# WIP device package for Huawei MediaPad 10 FHD S10-101x
pkgname=device-huawei-s10-101x
pkgdesc="Huawei MediaPad 10 FHD S10-101x"
pkgver=0.1
pkgrel=1
url="https://postmarketos.org"
license="MIT"
arch="armv7"
options="!check !archcheck"
depends="
	linux-huawei-s10-101x
	mkbootimg
	postmarketos-base
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	pmos-trace-sysinit.initd
	pmos-trace-boot.initd
	pmos-trace-default.initd
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	for phase in sysinit boot default; do
		install -Dm755 "$srcdir/pmos-trace-$phase.initd" \
			"$pkgdir/etc/init.d/pmos-trace-$phase"
		install -d "$pkgdir/etc/runlevels/$phase"
		ln -s "/etc/init.d/pmos-trace-$phase" \
			"$pkgdir/etc/runlevels/$phase/pmos-trace-$phase"
	done
}


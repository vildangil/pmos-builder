# Prebuilt kernel package for Huawei MediaPad 10 FHD S10-101x.
#
# The GitHub Actions workflow downloads kernel.zip from the latest published
# release of vildangil/mediapad-s10-hi3620-linux, extracts zImage + DTB here,
# and replaces the checksum placeholders below before pmbootstrap starts.
pkgname=linux-huawei-s10-101x
pkgver=4.9.51
pkgrel=0
pkgdesc="Linux 4.9 HiSilicon Hi3620 kernel for Huawei MediaPad 10 FHD"
arch="armv7"
_flavor="huawei-s10-101x"
url="https://github.com/vildangil/mediapad-s10-hi3620-linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"

source="
	zImage
	hi3620-s10-101x.dtb
	kernel.release
"
builddir="$srcdir"

build() {
	# Kernel is built separately in mediapad-s10-hi3620-linux CI.
	:
}

package() {
	# Keep the plain zImage here. deviceinfo_append_dtb=true makes
	# postmarketOS append hi3620-s10-101x.dtb exactly once when generating
	# the Huawei Android boot image.
	install -Dm644 "$srcdir/zImage" \
		"$pkgdir/boot/vmlinuz"

	install -Dm644 "$srcdir/hi3620-s10-101x.dtb" \
		"$pkgdir/boot/dtbs/hi3620-s10-101x.dtb"

	install -Dm644 "$srcdir/kernel.release" \
		"$pkgdir/usr/share/kernel/$_flavor/kernel.release"
}

sha512sums="
__ZIMAGE_SHA512__  zImage
__DTB_SHA512__  hi3620-s10-101x.dtb
__KERNEL_RELEASE_SHA512__  kernel.release
"
